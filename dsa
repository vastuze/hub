local function parseNumber(text)
    local cleaned = tostring(text):gsub(",", ""):gsub("%s", "")
    local number, suffix = cleaned:match("^%+?(%d+%.?%d*)([kKmMbB]?)$")
    if not number then return nil end
    return tonumber(number) * (({k = 1000, m = 1000000, b = 1000000000})[suffix:lower()] or 1)
end

local function formatNumber(number)
    local text = tostring(math.floor(number)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (text:gsub("^,", ""))
end


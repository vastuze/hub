local function pgFire(signal, ...)
    local ok, handlers = pcall(function() return getconnections(signal) end)
    if not ok or type(handlers) ~= "table" then return false end
    local args, fired = {...}, false
    for _, connection in ipairs(handlers) do
        local readable, fire = pcall(function()
            if connection.Enabled == false then return nil end
            return connection.Fire
        end)
        if readable and type(fire) == "function" then
            if not pcall(function() connection:Fire(unpack(args)) end) then
                error("Callback loi; dung de tranh bam nham.")
            end
            fired = true
        end
    end
    return fired
end

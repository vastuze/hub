local function finiteNumber(value)
    return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end
local function integerInRange(value, minimum, maximum)
    return finiteNumber(value) and value % 1 == 0 and value >= minimum and value <= maximum
end
if type(readfile) == "function" then
    local ok, data = pcall(function() return automationHttp:JSONDecode(readfile(automationFile)) end)
    if ok and type(data) == "table" then
        app.autoLeave = data.autoLeave == true
        app.autoUpgrade = data.autoUpgrade == true
        if integerInRange(data.goldTarget, 1, 1000000000) then app.goldTarget = data.goldTarget end
        if integerInRange(data.maxGames, 1, 1000000) then app.maxGames = data.maxGames end
        if integerInRange(data.gameCount, 0, 1000000) then app.gameCount = data.gameCount end
        countedJob = type(data.countedJob) == "string" and data.countedJob or nil
        upgradePending = data.upgradePending == true
    end
end
local function saveAutomation()
    local ok = false
    if type(writefile) == "function" then
        ok = pcall(function()
            writefile(automationFile, automationHttp:JSONEncode({autoLeave = app.autoLeave,
                autoUpgrade = app.autoUpgrade, goldTarget = app.goldTarget, maxGames = app.maxGames,
                gameCount = app.gameCount, countedJob = countedJob, upgradePending = upgradePending}))
        end)

    end
end
local lobbyPlaces = {[4658598196] = 14916516914, [5310627045] = 15393230099}
local function atLobby()
    return lobbyPlaces[game.GameId] == game.PlaceId
end
local function automationRemote(name)
    local storage = game:GetService("ReplicatedStorage")
    local assets = storage:FindFirstChild("Assets")
    local remotes = assets and assets:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild(name)
end
local function leaveReason()
    if atLobby() then return nil end
    if app.autoUpgrade and finiteNumber(app.goldBalance) and app.goldBalance >= app.goldTarget then return "gold" end
    if app.autoLeave and app.gameCount >= app.maxGames then return "games" end
end
app.shouldLeave = function() return app.leaving or leaveReason() ~= nil end
local function requestLobby(reason)
    if app.leaving or not app.running or atLobby() then return false end
    local post = automationRemote("POST")
    local character = Players.LocalPlayer.Character
    if not post or not post:IsA("RemoteEvent") or not character or not character:FindFirstChild("HumanoidRootPart") then return false end
    app.leaving = true
    local previousFarm = app.farm
    app.farm = false
    releaseCharacter()
    -- Keep the upgrade intent through teleport; persist before invoking game.
    local previousPending = upgradePending
    if reason == "gold" then upgradePending = true end
    saveAutomation()
    local ok = pcall(function() post:FireServer("Functions", "Teleport") end)
    if not ok then
        upgradePending = previousPending
        app.leaving, app.farm = false, previousFarm
        saveAutomation()
        warn("[TITAN UI] Teleport call failed; will retry.")
        return false
    end
    print("[TITAN UI] Requested lobby: " .. reason)
    -- FireServer is not confirmation; failed teleports may be retried after 15s.
    task.spawn(function()
        task.wait(15)
        if app.running and not atLobby() then app.leaving, app.farm = false, previousFarm end
    end)
    return true
end
local upgradeList = {"Blade_Durability", "ODM_Damage", "ODM_Gas", "ODM_Range", "ODM_Control", "Crit_Chance", "Crit_Damage", "ODM_Speed"}
local function readLiveGold()
    local node = Players.LocalPlayer:FindFirstChild("PlayerGui")
    for _, name in ipairs({"Interface", "Topbar", "Main", "Currencies", "Gold", "Amount"}) do node = node and node:FindFirstChild(name) end
    if not node then return nil end
    return tonumber((node.Text:gsub(",", ""):gsub("%s", "")))
end
local function startAutomation()
    task.spawn(function()
        local nextAction, lobbySince = 0, nil
        local upgradeAttempted = false
        while app.running do
            task.wait(0.25)
            local ok = pcall(function()
                local now = os.clock()
                if atLobby() then
                    lobbySince = lobbySince or now
                    if app.gameCount ~= 0 then app.gameCount = 0; saveAutomation() end
                    local liveGold = readLiveGold()
                    if app.autoUpgrade and not upgradeAttempted and finiteNumber(liveGold)
                        and liveGold >= app.goldTarget and now - lobbySince >= 2 then
                        local remote = automationRemote("GET")
                        if remote and remote:IsA("RemoteFunction") then
                            -- Once per lobby visit, not a loop that spends repeatedly.
                            upgradeAttempted = true
                            local invoked = pcall(function() remote:InvokeServer("S_Equipment", "Upgrade", upgradeList) end)
                            if invoked then
                                upgradePending = false
                                saveAutomation()
                                print("[TITAN UI] Sent full Equipment upgrade request; verify result in game.")
                            else warn("[TITAN UI] Upgrade request failed; toggle Auto Upgrade off/on to try again.") end
                        end
                    end
                    if not app.autoUpgrade then upgradeAttempted = false end
                    return
                end
                lobbySince = nil
                -- Match server entries, exactly as the supplied counter (not wins).
                if game:GetService("Workspace"):FindFirstChild("Titans") and game.JobId ~= "" and countedJob ~= game.JobId then
                    countedJob = game.JobId
                    app.gameCount = math.min(app.gameCount + 1, 1000000)
                    saveAutomation()
                    print("[TITAN UI] Match server count: " .. app.gameCount .. "/" .. app.maxGames)
                end
                if now < nextAction then return end
                local reason = leaveReason()
                if reason then nextAction = now + 3; requestLobby(reason) end
            end)
            if not ok then nextAction = os.clock() + 3 end
        end
    end)
end

    elseif nextTarget then
        lines[#lines + 1] = "Next target: " .. pgFormat(nextTarget) .. " Gold (level " .. tostring(milestone) .. ")"
    end
    if result.gradeBefore == result.gradeAfter and result.presses == 0 then

        end
    end
    if type(gold) ~= "number" then
        local text = awaitPath(interface, {"Topbar", "Main", "Currencies", "Gold", "Amount"}).Text
        text = text:gsub("<[^>]*>", ""):gsub(",", ""):gsub("%s", "")
        if text:match("^%d+$") then gold = tonumber(text) end
    end
    local target = 100000000 * (2 ^ rank)
    print("[AUTO PRESTIGE] 4.0: P" .. rank .. " | Gold " .. tostring(gold) .. " | Target " .. target)
    if type(gold) ~= "number" or gold < target then return end
    local start = awaitPath(equipment, {"Prestige", "B_Prestige"})
    if not isVisible(start) then
        print("[AUTO PRESTIGE] 4.0: Gold ready, but Level/XP or next-rank eligibility not ready.")
        return
    end
    local function waitUntil(callback, description, seconds)
        local deadline = os.clock() + (seconds or 30)
        repeat
            local result = callback()
            if result then return result end
            task.wait(0.1)
        until os.clock() >= deadline
        error("4.0 timeout: " .. description .. "; no automatic reset retry.")
    end
    local warning = awaitPath(interface, {"Warning"})
    assert(not isVisible(warning), "4.0: Another confirmation is open.")
    click(start)
    waitUntil(function()
        local title = findPath(warning, {"Prompt", "Main", "Title"})
        return isVisible(warning) and title and title.Text:lower():find("prestige", 1, true)
    end, "Prestige confirmation")
    task.wait(0.3)
    click(awaitPath(warning, {"Prompt", "Main", "Yes"}))
    local memories = require(ReplicatedStorage.Modules.Storage.Memories)
    local function cards(category)
        local found = {}
        for _, object in ipairs(workspace:GetDescendants()) do
            if object:IsA("ClickDetector") and object.Name == "Click"
                and object.Parent and object.Parent.Parent and object.Parent.Parent.Name == "Memories" then
                local card = object.Parent
                local info = findPath(card, {"Holder", "Front", "Main", "Inner", "Info"})
                if info and info:GetAttribute("Category") == category then
                    found[#found + 1] = {click = object, tag = info:GetAttribute("Tag"), card = card}
                end
            end
        end
        return found
    end
    local confirm = awaitPath(interface, {"Memories_Buttons", "M_Confirm"})
    local function selectCard(card, expectedText)
        task.wait(3) -- allow unpacking animation to finish
        assert(not isVisible(confirm), "4.0: Unexpected existing card selection; stopping.")
        local handlers = getconnections(card.click.MouseClick)
        assert(#handlers > 0, "4.0: Card has no accessible click handlers.")
        for _, connection in ipairs(handlers) do
            if connection.Enabled ~= false then connection:Fire(player) end
        end
        waitUntil(function() return isVisible(confirm) and confirm.Title.Text:upper() == expectedText end,
            "selected card confirmation " .. expectedText)
        task.wait(0.2)
        click(confirm)
    end
    local goldCard = waitUntil(function()
        for _, card in ipairs(cards("Boosts")) do
            if tostring(card.tag) == "3" and memories.Boosts["3"].Tag == card.card.Name then return card end
        end
    end, "Gold Boost card", 90)
    selectCard(goldCard, "NEXT")
    local talents = waitUntil(function()
        local available = cards("Talents")
        if #available > 0 then return available end
    end, "offered talents", 60)
    local selected = talents[math.random(1, #talents)]
    print("[AUTO PRESTIGE] 4.0: Gold Boost + random offered talent: " .. selected.card.Name)
    selectCard(selected, "FINISH")
    waitUntil(function()
        local buttons = interface:FindFirstChild("Memories_Buttons")
        local current = readRank()
        return isVisible(equipment) and buttons and not isVisible(buttons) and current == rank + 1
    end, "completed Prestige and updated rank", 120)

  local function parseCompactNumber(text)
    local cleaned = tostring(text):lower():gsub(",", ""):gsub("%s", "")
    local digits, suffix = cleaned:match("^(%d+%.?%d*)([kmb]?)$")
    if not digits then return nil end
    local number = tonumber(digits) * (({k = 1000, m = 1000000, b = 1000000000})[suffix] or 1)
    if number ~= number or number >= math.huge then return nil end
    return number
  end
  

  local function fitScreen(center)
      local camera = workspace.CurrentCamera
      if not camera then return end
      local viewport = camera.ViewportSize
      if not viewport or viewport.X <= 0 or viewport.Y <= 0 then return end
      local size = Window.Main.Size
      local width = math.max(size.X.Offset, 1)
      local height = math.max(size.Y.Offset, 1)
      -- Leave a little margin so the bottom bar and resize icon stay reachable.
      local scaleX = (viewport.X - 24) / width
      local scaleY = (viewport.Y - 60) / height
      mobileScale.Scale = math.min(1, math.max(0.4, math.min(scaleX, scaleY)))
      if center then
          Window.Main.Position = UDim2.fromScale(0.5, 0.5)
      end
  end

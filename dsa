local function pgUpgradeText(result, nextTarget, milestone)
    local spent = (result.goldBefore and result.goldAfter) and (result.goldBefore - result.goldAfter) or nil
    local lines = {
        "Grade: " .. tostring(result.gradeBefore or "?") .. " -> " .. tostring(result.gradeAfter or "?"),

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TIMEOUT = 30
local stopMissionFarm
local lobbyPlaces = {[4658598196] = 14916516914, [5310627045] = 15393230099}
local missionPlaces = {
    [4658598196] = {13379349730, 14012874501, 14638336319, 13904207646,
        15220308770, 17688739434, 15824912319, 126678335159530, 112374853034490},
    [5310627045] = {17373821193, 15393230324, 17373828240, 17373824844,
        18182863694, 110415968652032, 139092911630535, 133979984250876, 85939958627504},
}

local function inMission()
    for _, placeId in ipairs(missionPlaces[game.GameId] or {}) do
        if game.PlaceId == placeId then return true end
    end
    return false
end

local function startLobbyTimer()
    local env = type(getgenv) == "function" and getgenv() or _G
    local previous = env.AutoPrestigeLobbyTimer
    -- Re-executing in the same server must not reset or duplicate the timer.
    if previous and previous.jobId == game.JobId and previous.placeId == game.PlaceId then
        print("[AUTO PRESTIGE] 10-minute Lobby timer already active.")
        return
    end
    local timer = {jobId = game.JobId, placeId = game.PlaceId, deadline = os.clock() + 600}
    env.AutoPrestigeLobbyTimer = timer
    print("[AUTO PRESTIGE] In mission: requesting Lobby in 600 seconds.")
    task.spawn(function()
        while env.AutoPrestigeLobbyTimer == timer and inMission() do
            local remaining = timer.deadline - os.clock()
            if remaining <= 0 then break end
            task.wait(math.min(remaining, 1))
        end
        while env.AutoPrestigeLobbyTimer == timer and inMission() do
            timer.leaving = true
            if stopMissionFarm then stopMissionFarm() end
            local assets = ReplicatedStorage:FindFirstChild("Assets")
            local remotes = assets and assets:FindFirstChild("Remotes")
            local post = remotes and remotes:FindFirstChild("POST")
            local player = Players.LocalPlayer
            local character = player and player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if post and post:IsA("RemoteEvent") and root then
                root.Anchored = false
                local ok, message = pcall(function()
                    post:FireServer("Functions", "Teleport")
                end)
                if ok then
                    print("[AUTO PRESTIGE] 10 minutes elapsed: Lobby return requested.")
                else
                    warn("[AUTO PRESTIGE] Lobby request failed: " .. tostring(message))
                end
                -- FireServer is not confirmation. Retry only after 15 seconds.
                task.wait(15)
            else
                task.wait(1)
            end
        end
        if env.AutoPrestigeLobbyTimer == timer then env.AutoPrestigeLobbyTimer = nil end
    end)
end

local function waitForValue(callback)
    local deadline = os.clock() + TIMEOUT
    repeat
        local value = callback()
        if value then return value end
        task.wait(0.25)
    until os.clock() >= deadline
    return nil
end

local function isVisible(button)
    if not button.Parent then return false end
    local node = button
    while node and node ~= game do
        if (node:IsA("GuiObject") and not node.Visible)
            or (node:IsA("CanvasGroup") and node.GroupTransparency >= 0.99)
            or (node:IsA("ScreenGui") and not node.Enabled) then
            return false
        end
        node = node.Parent
    end
    return true
end

local function selectSlot(button)
    -- Use one signal only, so the same selection is not dispatched twice.
    if type(getconnections) == "function" then
        for _, eventName in ipairs({"MouseButton1Click", "Activated"}) do
            local inspected, handlers = pcall(function() return getconnections(button[eventName]) end)
            if inspected and type(handlers) == "table" then
                local usable = {}
                for _, connection in ipairs(handlers) do
                    local accessible, fire = pcall(function()
                        if connection.Enabled == false then return nil end
                        return connection.Fire
                    end)
                    if accessible and type(fire) == "function" then
                        usable[#usable + 1] = connection
                    end
                end
                if #usable > 0 then
                    local failed = false
                    for _, connection in ipairs(usable) do
                        local fired = pcall(function()
                            if eventName == "Activated" then connection:Fire(nil, 1)
                            else connection:Fire() end
                        end)
                        failed = failed or not fired
                    end
                    if failed then error("A Select_A callback failed; refusing duplicate input.") end
                    return
                end
            end
        end
    end

    -- Same virtual-input fallback as the source selection flow.
    local gui = game:GetService("GuiService")
    local virtualInput = game:GetService("VirtualInputManager")
    local previousSelectable = button.Selectable
    local previousSelection = gui.SelectedObject
    local function key(code)
        virtualInput:SendKeyEvent(true, code, false, game)
        task.wait(0.05)
        virtualInput:SendKeyEvent(false, code, false, game)
    end
    local ok, message = pcall(function()
        key(Enum.KeyCode.BackSlash)
        task.wait(0.1)
        button.Selectable = true
        gui.SelectedObject = button
        task.wait(0.1)
        if gui.SelectedObject ~= button then error("Select_A could not be focused.") end
        key(Enum.KeyCode.Return)
        task.wait(0.8)
        if not isVisible(button) then return end
        gui.SelectedObject = nil
        local position, size = button.AbsolutePosition, button.AbsoluteSize
        if size.X <= 0 or size.Y <= 0 then error("Select_A has no visible size.") end
        local x, y = position.X + size.X / 2, position.Y + size.Y / 2
        virtualInput:SendMouseMoveEvent(x, y, game)
        task.wait(0.05)
        virtualInput:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.1)
        virtualInput:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    pcall(function()
        virtualInput:SendKeyEvent(false, Enum.KeyCode.BackSlash, false, game)
        virtualInput:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
        local position = button.AbsolutePosition
        virtualInput:SendMouseButtonEvent(position.X, position.Y, 0, false, game, 0)
    end)
    pcall(function()
        if gui.SelectedObject == button then gui.SelectedObject = previousSelection end
        button.Selectable = previousSelectable
    end)
    if not ok then error("Slot A input failed: " .. tostring(message)) end
end

local function selectLobby()
    if not waitForValue(function() return game:IsLoaded() end) then
        error("Game did not finish loading within 30 seconds.")
    end
    if not lobbyPlaces[game.GameId] then error("Unsupported game; no known lobby place.") end
    if lobbyPlaces[game.GameId] == game.PlaceId then
        print("[AUTO PRESTIGE] Step 1 complete: already in Lobby.")
        return true
    end
    local player = waitForValue(function() return Players.LocalPlayer end)
    if not player then error("LocalPlayer did not load.") end
    local button = waitForValue(function()
        local node = player:FindFirstChild("PlayerGui")
        for _, name in ipairs({"Interface", "Title_Screen", "Slots", "A", "Select_A"}) do
            node = node and node:FindFirstChild(name)
        end
        if node and node:IsA("GuiButton") and isVisible(node) then return node end
    end)
    if not button then error("Visible Select_A button did not load; start from the slot-selection screen.") end
    selectSlot(button)
    task.wait(1)
    local remote = waitForValue(function()
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local remotes = assets and assets:FindFirstChild("Remotes")
        local get = remotes and remotes:FindFirstChild("GET")
        if get and get:IsA("RemoteFunction") then return get end
    end)
    if not remote then error("Assets.Remotes.GET did not load.") end
    remote:InvokeServer("Functions", "Teleport", "Lobby", nil)
    -- A successful invocation is a request, not proof that teleport completed.
    print("[AUTO PRESTIGE] Step 1: selected Slot A and requested Lobby teleport.")
    return false
end

local function findPath(root, names)
    local node = root
    for _, name in ipairs(names) do node = node and node:FindFirstChild(name) end
    return node
end

local function awaitPath(root, names)
    local node = waitForValue(function() return findPath(root, names) end)
    assert(node, "UI did not load: " .. table.concat(names, "."))
    return node
end

local function click(button)
    assert(type(getconnections) == "function", "Executor requires getconnections for Equipment UI.")
    local handlers = getconnections(button.MouseButton1Click)
    assert(#handlers > 0, "No click handlers: " .. button:GetFullName())
    for _, connection in ipairs(handlers) do connection:Fire() end
end

local function upgradeAll(player, interface, equipment, values)
    local topbar = require(ReplicatedStorage.Modules["User Interface"].Topbar)
    local function currency(name)
        -- Topbar keeps the exact balance in New while the display animates.
        for _, entry in pairs(topbar.Objects) do
            if entry.Module == "Topbar" and entry.Currency == name and entry.Object then
                local amount = entry.Object:GetAttribute("New")
                if type(amount) == "number" and amount >= 0 then return amount end
            end
        end
        local label = findPath(interface, {"Topbar", "Main", "Currencies", name, "Amount"})
        local text = label and label.Text:gsub("<[^>]*>", ""):gsub(",", ""):gsub("%s", "")
        -- Do not treat abbreviated amounts such as 1.2M as an exact balance.
        if text and text:match("^%d+$") then return tonumber(text) end
    end
    local gold, gems = currency("Gold"), currency("Gems")
    print("[AUTO PRESTIGE] Gold: " .. tostring(gold) .. " | Gems: " .. tostring(gems))
    local blades = findPath(equipment, {"Stats", "Blades"})
    if not blades or not isVisible(blades) then
        print("[AUTO PRESTIGE] Blades upgrades not active; continuing step 2.")
        return
    end
    -- Let the game's Upgrade All handler decide which upgrades are affordable.
    -- Stop if Gold does not decrease; never keep clicking a refused purchase.
    for _ = 1, 120 do
        gold = currency("Gold")
        if not gold or gold <= 0 then
            print("[AUTO PRESTIGE] No available Gold balance; continuing step 2.")
            return
        end
        local all = findPath(equipment, {"Stats", "All"})
        if not all or not isVisible(all) then
            print("[AUTO PRESTIGE] Upgrade All unavailable; continuing step 2.")
            return
        end
        local previousGold = gold
        print("[AUTO PRESTIGE] Clicking Upgrade All. Gold: " .. gold)
        click(all:IsA("GuiButton") and all or awaitPath(all, {"Interact"}))
        task.wait(1)
        local deadline = os.clock() + 8
        repeat
            gold = currency("Gold")
            if gold and gold < previousGold then break end
            task.wait(0.25)
        until os.clock() >= deadline
        if not gold or gold >= previousGold then
            print("[AUTO PRESTIGE] Gold did not decrease (insufficient Gold or no upgrade); continuing step 2.")
            return
        end
        print("[AUTO PRESTIGE] Gold remaining: " .. gold .. " | Gems: " .. tostring(currency("Gems")))
    end
end

local function readDifficulty(player)
    local gui = awaitPath(player, {"PlayerGui"})
    local interface = awaitPath(gui, {"Interface"})
    local equipment = awaitPath(interface, {"Equipment"})
    -- Avoid toggling an already-open Equipment menu closed on a rerun.
    if not isVisible(equipment) then
        click(awaitPath(interface, {"Topbar", "Main", "Categories", "Equipment", "Interact"}))
        task.wait(1)
    end
    click(awaitPath(equipment, {"Categories", "Upgrades", "Main", "Interact"}))
    task.wait(1)

    local values = require(ReplicatedStorage.Modules.Storage.Values)
    local upgraded, upgradeError = pcall(upgradeAll, player, interface, equipment, values)
    if not upgraded then
        warn("[AUTO PRESTIGE] Upgrade stopped; continuing step 2: " .. tostring(upgradeError))
    end
    local gradeIndex, grade
    local found = waitForValue(function()
        local title = findPath(equipment, {"Categories", "Upgrades", "Main", "Title"})
        if not title then return nil end
        local text = title.Text:gsub("<[^>]*>", ""):upper()
        grade = text:match("%[([A-S][%+%-]?)%s+GRADE%]")
            or text:match("%[GRADE%s+([A-S][%+%-]?)%]")
        for index, tag in pairs(values.Pot_Tags) do
            if tag == grade then gradeIndex = index; return true end
        end
    end)
    assert(found, "Could not read Equipment Grade.")

    -- Highest unlocked Missions difficulty; Freedom additionally needs Prestige 3.
    -- The live slot Prestige is unavailable here, so do not infer it from Grade.
    local difficulty
    local prestige = player:GetAttribute("Prestige")
    for _, requirement in ipairs(values.Difficulty_Potential.Missions) do
        if gradeIndex >= requirement[2]
            and (requirement[1] ~= "Freedom" or (type(prestige) == "number" and prestige >= 3)) then
            difficulty = requirement[1]
        end
    end
    assert(difficulty, "No eligible difficulty for Grade " .. tostring(grade))
    print("[AUTO PRESTIGE] Step 1.5: Grade " .. grade .. " -> " .. difficulty)
    return difficulty
end

local function startMission(player, difficulty)
    local remote = awaitPath(ReplicatedStorage, {"Assets", "Remotes", "GET"})
    local config = {Name = "Shiganshina", Type = "Missions", Objective = "Breach", Difficulty = difficulty}
    local function matches(candidate)
        if typeof(candidate) ~= "Instance" or not candidate.Parent
            or not candidate:IsA("StringValue") or candidate.Name ~= config.Name then return false end
        local leader = candidate:FindFirstChild("Leader")
        return leader and leader.Value == player.Name and candidate.Value == config.Difficulty
            and candidate:GetAttribute("Type") == config.Type
            and candidate:GetAttribute("Objective") == config.Objective
    end
    local function findMission()
        local folder = ReplicatedStorage:FindFirstChild("Missions")
        local found
        if folder then
            for _, candidate in ipairs(folder:GetChildren()) do
                if matches(candidate) then
                    assert(not found, "Multiple matching missions; disband duplicates first.")
                    found = candidate
                else
                    local leader = candidate:FindFirstChild("Leader")
                    assert(not leader or leader.Value ~= player.Name,
                        "You lead another mission; disband it before running.")
                end
            end
        end
        return found
    end
    local mission = findMission()
    if not mission then
        print("[AUTO PRESTIGE] Step 2: creating Shiganshina / Breach / " .. difficulty)
        remote:InvokeServer("S_Missions", "Create", config)
        mission = waitForValue(findMission)
    end
    assert(mission, "Mission did not replicate; check party and difficulty unlocks.")
    local wanted = {"No Perks", "No Skills", "No Memories", "Nightmare", "Injury Prone",
        "Chronic Injuries", "Fog", "Glass Cannon", "Time Trial", "Fatigue", "Evolution"}
    local excluded = {"Oddball", "Boring", "Simple", "Primitive"}
    local function enabled(name)
        assert(matches(mission), "Mission changed or you are no longer leader.")
        local state = mission:GetAttribute("Modifiers")
        assert(type(state) == "string", "Modifiers attribute is not ready.")
        return state:find(name, 1, true) ~= nil
    end
    assert(waitForValue(function() return type(mission:GetAttribute("Modifiers")) == "string" end),
        "Modifiers did not load.")
    local function setModifier(name, target)
        if enabled(name) == target then return end
        print("[AUTO PRESTIGE] " .. (target and "Enable: " or "Disable: ") .. name)
        remote:InvokeServer("S_Missions", "Modify", name)
        local deadline = os.clock() + 8
        repeat
            task.wait(0.2)
            if enabled(name) == target then task.wait(0.5); return end
        until os.clock() >= deadline
        -- Modify toggles state; never blindly retry a delayed request.
        error("Modifier not confirmed: " .. name .. " | " .. tostring(mission:GetAttribute("Modifiers")))
    end
    for _, name in ipairs(excluded) do setModifier(name, false) end
    for _, name in ipairs(wanted) do setModifier(name, true) end
    task.wait(1)
    for _, name in ipairs(excluded) do assert(not enabled(name), "Excluded modifier enabled: " .. name) end
    for _, name in ipairs(wanted) do assert(enabled(name), "Missing modifier: " .. name) end
    print("[AUTO PRESTIGE] Step 2: confirmed 11 modifiers; requesting Start.")
    remote:InvokeServer("S_Missions", "Start")
    print("[AUTO PRESTIGE] Start requested.")
end

local function startMissionFarm()
    local env = type(getgenv) == "function" and getgenv() or _G
    if env.AutoPrestigeFarm and env.AutoPrestigeFarm.stop then env.AutoPrestigeFarm.stop() end
    local player = waitForValue(function() return Players.LocalPlayer end)
    assert(player, "LocalPlayer did not load for Auto Farm.")
    local input = game:GetService("VirtualInputManager")
    local tweenService = game:GetService("TweenService")
    local farm = {running = true, connections = {}}
    env.AutoPrestigeFarm = farm
    local function active()
        local timer = env.AutoPrestigeLobbyTimer
        return farm.running and env.AutoPrestigeFarm == farm and inMission()
            and not (timer and (timer.leaving or os.clock() >= timer.deadline))
    end
    local function release()
        if farm.tween then farm.tween:Cancel(); farm.tween = nil end
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if root then root.Anchored = false end
        pcall(function() game:GetService("UserInputService").MouseBehavior = Enum.MouseBehavior.Default end)
    end
    function farm.stop()
        farm.running = false
        release()
        for _, connection in ipairs(farm.connections) do connection:Disconnect() end
        farm.connections = {}
    end
    stopMissionFarm = farm.stop
    local function remote(name)
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local remotes = assets and assets:FindFirstChild("Remotes")
        return remotes and remotes:FindFirstChild(name)
    end
    local function path(root, names) return findPath(root, names) end
    farm.connections[#farm.connections + 1] = player.CharacterAdded:Connect(function(character)
        release()
        local root = character:WaitForChild("HumanoidRootPart", 5)
        if root then root.Anchored = false end
    end)
    local function key(code)
        input:SendKeyEvent(true, code, false, game)
        task.wait(0.05)
        input:SendKeyEvent(false, code, false, game)
    end
    -- One Retry request per visible Rewards screen; never retry while leaving.
    task.spawn(function()
        local wasVisible = false
        while active() do
            task.wait(0.1)
            local main = path(player, {"PlayerGui", "Interface", "Rewards", "Main"})
            local shown = main and isVisible(main) or false
            if shown and not wasVisible then
                wasVisible = true
                task.wait(0.5)
                if active() and main.Parent and isVisible(main) then
                    local get = remote("GET")
                    if get and get:IsA("RemoteFunction") then
                        local ok, err = pcall(function() get:InvokeServer("Functions", "Retry", "Add") end)
                        if not ok then warn("[AUTO PRESTIGE] Retry failed: " .. tostring(err)) end
                    end
                end
            elseif not shown then wasVisible = false end
        end
    end)
    task.spawn(function()
        local keys = {W = Enum.KeyCode.W, A = Enum.KeyCode.A, S = Enum.KeyCode.S, D = Enum.KeyCode.D}
        while active() do
            task.wait(0.1)
            pcall(function()
                local gui = player:FindFirstChild("PlayerGui")
                if not gui then return end
                for _, label in ipairs(gui:GetDescendants()) do
                    if not active() then return end
                    if label.Name == "Key" and label:IsA("TextLabel") and isVisible(label) then
                        local code = keys[label.Text:upper()]
                        if code then key(code) end
                    end
                end
            end)
        end
    end)
    local function rig(character)
        return workspace:FindFirstChild("Rig_" .. character.Name, true) or character
    end
    local function bladeSets(character)
        local model, count = rig(character), 0
        for index = 1, 3 do
            local set = model:FindFirstChild("Left_" .. index, true)
            if not set or set:GetAttribute("Used") == nil then count = count + 1 end
        end
        return count
    end
    local function napeOf(titan)
        return path(titan, {"Hitboxes", "Hit", "Nape"}) or titan:FindFirstChild("Nape", true)
    end
    local function iteration()
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or humanoid.Health <= 0 then release(); task.wait(0.5); return end
        local function valid()
            return active() and player.Character == character and root.Parent == character and humanoid.Health > 0
        end
        if bladeSets(character) <= 0 then
            release()
            local station, nearest = nil, math.huge
            for _, part in ipairs(workspace:GetDescendants()) do
                if part.Name == "Refill" and part:IsA("BasePart") then
                    local distance = (root.Position - part.Position).Magnitude
                    if distance < nearest then station, nearest = part, distance end
                end
            end
            if station and valid() then
                root.CFrame = station.CFrame * CFrame.new(0, 3, 0)
                task.wait(0.3)
                if not valid() then return end
                local post, get = remote("POST"), remote("GET")
                if post then post:FireServer("Attacks", "Reload", station) end
                if get then get:InvokeServer("Blades", "Reload") end
                task.wait(1.5)
            else task.wait(0.5) end
            return
        end
        local titans = workspace:FindFirstChild("Titans")
        local target, nape, nearest = nil, nil, math.huge
        if titans then
            for _, titan in ipairs(titans:GetChildren()) do
                local hum = titan:IsA("Model") and titan:FindFirstChild("Humanoid")
                local neck = hum and napeOf(titan)
                if hum and hum.Health > 0 and neck and neck:IsA("BasePart") then
                    local distance = (root.Position - neck.Position).Magnitude
                    if distance < nearest then target, nape, nearest = titan, neck, distance end
                end
            end
        end
        if not target then release(); task.wait(0.5); return end
        local hand = rig(character):FindFirstChild("LeftHand", true)
        local blade = hand and hand:FindFirstChild("Blade_1")
        if blade and blade:GetAttribute("Broken") == true then
            root.Anchored = true
            key(Enum.KeyCode.R)
            task.wait(0.6)
            root.Anchored = false
        end
        if not valid() or not nape.Parent then return end
        root.Anchored = false
        local height = math.max(400, nape.Position.Y + 50)
        local destination = CFrame.new(nape.Position.X, height, nape.Position.Z) * CFrame.new(0, 0, 2)
        local duration = math.max(0.05, (root.Position - destination.Position).Magnitude / 300)
        local tween = tweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = destination})
        farm.tween = tween
        tween:Play()
        local started = os.clock()
        while valid() and os.clock() - started < duration
            and tween.PlaybackState == Enum.PlaybackState.Playing do task.wait(0.05) end
        tween:Cancel()
        if farm.tween == tween then farm.tween = nil end
        if not valid() or not nape.Parent then release(); return end
        root.Anchored = true
        local post = remote("POST")
        if post then
            post:FireServer("Attacks", "Slash", true)
            post:FireServer("Hitboxes", "Register", nape, math.random() * 0.1 + 0.05)
            post:FireServer("Attacks", "Slash", false)
        end
        input:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        input:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        task.wait(0.15)
        root.Anchored = false
    end
    task.spawn(function()
        while active() do
            local ok, err = pcall(iteration)
            if not ok then release(); warn("[AUTO PRESTIGE] Farm: " .. tostring(err)); task.wait(1) end
            task.wait()
        end
        farm.stop()
    end)
    print("[AUTO PRESTIGE] Step 2.5: Auto Farm + Auto Retry enabled (no webhook/HUD).")
end

local ok, message = pcall(function()
    if inMission() then
        startLobbyTimer()
        startMissionFarm()
        return
    end
    if not selectLobby() then
        print("[AUTO PRESTIGE] Re-run this file in Lobby after teleport to continue steps 1.5 and 2.")
        return
    end
    local player = waitForValue(function() return Players.LocalPlayer end)
    assert(player, "LocalPlayer did not load.")
    local difficulty = readDifficulty(player)
    startMission(player, difficulty)
end)
if not ok then warn("[AUTO PRESTIGE] Stopped: " .. tostring(message)) end

local hoverNames = setmetatable({}, {__mode = "k"})

local function cleanText(text)
    return (tostring(text):gsub("<[^>]*>", ""):gsub("_", " "):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function textSnapshot(root)
    local result = {}
    for _, node in ipairs(root:GetDescendants()) do
        if node:IsA("TextLabel") or node:IsA("TextButton") then
            result[node] = {text = cleanText(node.Text), shown = visible(node)}
        end
    end
    return result
end

local function chooseTooltip(before, after)
    local best, bestScore, ambiguous = nil, 0, false
    for node, entry in pairs(after) do
        local old = before[node]
        local changed = not old or not old.shown or old.text ~= entry.text
        local text = entry.text
        if entry.shown and changed and text ~= "" and #text <= 100 and not text:find("\n")
            and not parseNumber(text) then
            local key = node.Name:lower()
            local score = 0
            -- Accept named title fields, not arbitrary changed stats/descriptions.
            if key == "title" or key == "name" or key == "itemname" or key == "rewardname" then score = 10 end
            local parent = node.Parent
            while parent do
                local name = parent.Name:lower()
                if name:find("tooltip", 1, true) or name == "hover" then
                    if key ~= "description" and key ~= "quantity" then score = score + 5 end
                    break
                end
                parent = parent.Parent
            end
            if key == "description" or key == "quantity" or key == "amount" then score = 0 end
            if score > bestScore then
                best, bestScore, ambiguous = text, score, false
            elseif score > 0 and score == bestScore and text ~= best then
                ambiguous = true
            end
        end
    end
    if not ambiguous then return best end
end

local function fireHover(frame, eventName)
    if type(getconnections) ~= "function" then return false end
    local ok, connections = pcall(function() return getconnections(frame[eventName]) end)
    if not ok then return false end
    local fired = false
    for _, connection in ipairs(connections) do
        local success = pcall(function() connection:Fire() end)
        fired = fired or success
    end
    return fired
end


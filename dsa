    if not ranks[rank + 1] then return end
    local topbar = require(ReplicatedStorage.Modules["User Interface"].Topbar)
    local gold
    for _, entry in pairs(topbar.Objects) do
        if entry.Module == "Topbar" and entry.Currency == "Gold" and entry.Object then

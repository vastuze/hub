    if not station or not post or not post:IsA("RemoteEvent") then
        task.wait(0.5)
        return
    end
    local oldCF = root.CFrame
    local function valid()
        return app.farm and player.Character == character and root.Parent == character
    end
    -- Keep the character anchored for the whole refill so it never falls.
    root.Anchored = true
    local ok = pcall(function()
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.CFrame = station.CFrame + Vector3.new(0, 3, 0)
        task.wait(1)
        if not valid() then return end
        post:FireServer("Attacks", "Reload", station)
        task.wait(0.5)
    end)
    if valid() then
        -- Return to the original spot and keep hovering there.
        root.CFrame = oldCF
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        -- Cooldown stays inside the farm loop: no tween/attacks during refill.
        local deadline = os.clock() + 5
        while valid() and os.clock() < deadline do task.wait(0.1) end
    end
    -- Release only if the farm is stopping; the farm loop unanchors before tweening.
    if root.Parent == character and not app.farm then root.Anchored = false end

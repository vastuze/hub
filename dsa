local function formatItemName(name)
    local text = cleanText(name):lower()
    return (text:gsub("%a", string.upper, 1))
end

local function snapshot(items)
    local rows, keys, goldReward, gemsReward = {}, {}, nil, nil
    for _, item in ipairs(items:GetChildren()) do
        if item:IsA("GuiObject") then
            local inner = childPath(item, {"Main", "Inner"})
            if inner then
                local quantity = inner:FindFirstChild("Quantity")
                local icon = inner:FindFirstChild("Icon")
                local amount = quantity and quantity.Text or "1"
                local name = item:GetAttribute("ItemName") or item:GetAttribute("RewardName")
                local cached = hoverNames[item]
                if cached and cached.icon == (icon and icon.Image) then name = cached.name end
                if type(name) ~= "string" or name == "" then name = "Chua ro ten [" .. item.Name .. "]" end
                local number = parseNumber(amount)
                if cleanText(name):lower() == "gold" and number then goldReward = (goldReward or 0) + number end
                if cleanText(name):lower() == "gems" and number then gemsReward = (gemsReward or 0) + number end
                rows[#rows + 1] = "+" .. (number and formatNumber(number) or tostring(amount)) .. " " .. formatItemName(name)
                keys[#keys + 1] = item.Name .. ":" .. tostring(amount) .. ":" .. tostring(icon and icon.Image)
            end
        end
    end
    table.sort(rows)
    table.sort(keys)
    return rows, table.concat(keys, "|"), goldReward, gemsReward
end

